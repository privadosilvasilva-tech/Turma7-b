# Copie este arquivo para ".env" apenas se quiser personalizar algo.
# O site funciona sem esse arquivo: a chave de sessão é gerada e guardada
# sozinha (em db/.jwt-secret), e a conta do proprietário é criada pela
# própria tela do site na primeira vez que o site é aberto.

# Porta do servidor (opcional)
PORT=3000

# Nome da turma, exibido no site (opcional)
NOME_DA_TURMA=Minha Turma
