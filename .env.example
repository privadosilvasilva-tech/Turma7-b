# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA suba o arquivo ".env" para o GitHub ou qualquer lugar público.

# Porta do servidor
PORT=3000

# Segredo usado para assinar os tokens de sessão (JWT).
# Gere um valor aleatório forte, por exemplo rodando no terminal:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_por_um_valor_aleatorio_bem_grande

# Credenciais do PROPRIETÁRIO (dono) do sistema.
# Usadas UMA VEZ pelo script "npm run seed" para criar a conta do dono.
# Depois disso você pode (e deve) apagar essas duas linhas do .env.
OWNER_USERNAME=andry
OWNER_PASSWORD=troque_por_uma_senha_forte

# Nome da turma, exibido no site
NOME_DA_TURMA=Minha Turma
